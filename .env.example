# Copy to .env in the repository root. Never commit .env or real credentials.
NODE_ENV=development
PORT=5000
# Set to 1 only behind one trusted reverse proxy (such as Render); 0 for direct LAN.
TRUST_PROXY=0

# Local MongoDB, or a private mongodb+srv:// Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/codearena

# REQUIRED: generate a unique random secret with at least 32 characters.
JWT_SECRET=

# Comma-delimited browser origin allowlist; no paths or trailing slashes.
# For LAN access add http://YOUR_ACTUAL_LAN_IP:5000.
# For deployment replace these with the exact public HTTPS origin.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5000

# Leave the key empty to use manual grading. The key is read only by Express.
NLINECOMPILER_API_URL=https://api.onlinecompiler.io/api
ONLINECOMPILER_API_KEY=
ONLINECOMPILER_OCOMPILER=python-3.14
ONLINECOMPILER_CONCURRENCY=2
ONLINECOMPILER_RETRIES=3

# Required only for npm run seed (npm.cmd run seed on Windows).
# Prefer temporary PowerShell env vars as shown in README; no built-in login exists.
# Password: at least 10 characters, at most 72 UTF-8 bytes (bcrypt limit).
DEMO_MENTOR_EMAIL=
DEMO_MENTOR_PASSWORD=
